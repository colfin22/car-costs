# Copy to .env (and point your service manager at it, e.g. a systemd
# EnvironmentFile) — .env itself must never be committed.

# Enables the login gate — set this on every install; your receipts, certs
# and documents live behind it. (Unset, the app runs open — only defensible
# on a network nobody else can reach.) LAN monitoring/sensor callers are
# exempt either way. Rotating the value signs out every session.
CARCOSTS_PASSWORD=change-me

# Optional: where the SQLite database lives (photos are stored beside it).
# Defaults to ./data/carcosts.db
#CARCOSTS_DB=/opt/carcosts/data/carcosts.db

# Optional: per-file size cap for document attachments, in MB (default 10).
#CARCOSTS_MAX_DOC_MB=10
